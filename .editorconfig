# This is the root configuration file for Echo
root = true

# Global settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = true

# C# settings for the Web API and Core logic
[*.cs]
indent_size = 4

# ---- Naming rule: Types and methods should be PascalCase ----
dotnet_naming_rule.types_and_methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_and_methods_should_be_pascal_case.symbols = all_types_and_methods
dotnet_naming_rule.types_and_methods_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.all_types_and_methods.applicable_kinds = class, struct, interface, enum, delegate, method
dotnet_naming_symbols.all_types_and_methods.applicable_accessibilities = public, internal, private, protected

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# The universal .NET rule to minimize full qualifications
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
resharper_csharp_prefer_fully_qualified_references = false


# ---- Naming rule: Private fields should be prefixed with _ ----
dotnet_naming_rule.private_fields_prefix.severity = suggestion
dotnet_naming_rule.private_fields_prefix.symbols = private_fields
dotnet_naming_rule.private_fields_prefix.style = prefix_underscore_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.prefix_underscore_style.required_prefix = _
dotnet_naming_style.prefix_underscore_style.capitalization = camel_case

# React and Frontend settings
[*.{js,jsx,ts,tsx,json,css}]
indent_size = 2

