DB_NAME=echo_db
DB_USERNAME=echo_user
DB_PASSWORD=

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=echo-api
JWT_AUDIENCE=echo-clients

RUN_DATABASE_MIGRATIONS_ON_STARTUP=true

# The public URL the frontend is reachable at. Used to build links in outbound emails.
# Dev:  http://localhost:5173
# Prod: https://your-church-platform.example.com
# Required in non-dev environments — the API refuses to start if unset. Must be https outside development.
FRONTEND_BASE_URL=

MAIL_CLIENT_ADDRESS=onboarding@resend.dev
RESEND_API_KEY=
LUCKYPENNY_LICENSE_KEY=
