# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=echo_db
DB_USERNAME=username
DB_PASSWORD=password

# ConnectionStrings
ConnectionStrings__echodb="Host=db;Port=5432;Database=echo_db;Username=username;Password=password"

# Security (Jwt)
Jwt__Issuer=echo-api
Jwt__Audience=echo-clients
Jwt__PrivateKey=
Jwt__PublicKey=
# Leave empty except during a key rotation grace period, when it holds the public key that
# was active before the rotation. See the runbook in docs/Infrastructure.md.
Jwt__PreviousPublicKey=

Jwt__PreviousPrivateKey=

# Api Security (Cors)
# A comma-separated list of origins allowed to make requests to the API.
# Example: http://localhost:5173,https://app.echo.church
Cors__AllowedOrigins=http://localhost:5173

# Frontend Identity
Frontend__BaseUrl=http://localhost:5173
# The API's own public address. Production: https://<APP_DOMAIN>/api
Api__BaseUrl=http://localhost:5025

# External Services
MailClient__Address=onboarding@resend.dev
Resend__ApiKey=apikey

# Encrypts invitation codes so they can be shown again. Base64 of 32 random bytes.
# Generate with: sh backend/tools/invitation-key-setup/SetupInvitationKey.sh env
Invitations__CodeKey=

# HTTPS (production). The name the app is reached on, e.g. echo.net. Its DNS record must point at this server before
# the first certificate is requested (infra/nginx/certs.sh). Set Cors__AllowedOrigins and Frontend__BaseUrl to
# https://<this name>. CERTBOT_STAGING=1 uses Let's Encrypt's staging service while trying things out.
# To run this on your own machine instead, use echo.localhost and get its certificate from infra/nginx/local-certs.sh.
APP_DOMAIN=
CERTBOT_EMAIL=
CERTBOT_STAGING=0

# Observability (the obs profile: Alloy, Loki, Prometheus, Tempo, Grafana)
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=Echo.Api
# Grafana's admin account. In production it is at https://APP_DOMAIN/grafana/. Use a long random password and create
# everyone else as their own user in Grafana.
GF_ADMIN_PASSWORD=
# Gatus (https://APP_DOMAIN/status/): login admin plus this bcrypt hash, base64-encoded:
# htpasswd -bnBC 10 "" 'the password' | tr -d ':\n' | base64 -w0
STATUS_PASSWORD_HASH=
# Shared secret the backup and certificate jobs report to Gatus with, e.g. openssl rand -hex 24.
STATUS_HEARTBEAT_TOKEN=
# Password of the read-only Postgres role Alloy reads database metrics with. A new database creates the role on its
# own (infra/postgres/init/monitor-role.sh). Use letters and digits only, e.g. openssl rand -hex 24.
MONITOR_PASSWORD=
# Optional. Names this machine in every metric and log; how much API log noise Alloy keeps (13 = warnings and
# above); and the share of ordinary traces kept, in percent.
# ALLOY_HOST=echo-app
# API_LOG_MIN_SEVERITY=13
# TRACES_SAMPLE_PERCENT=1
# Optional. How long each store keeps data (the defaults).
# LOKI_RETENTION=672h
# LOKI_NGINX_RETENTION=168h
# TEMPO_RETENTION=168h
# PROMETHEUS_RETENTION=30d

# System Settings
# Triggers Database.MigrateAsync() on startup. Set to false in Production: there the migrator runs before the API.
RunMigrationsOnStartup=true

# Production only: the deploy script sets the first two per release; development builds locally.
# IMAGE_REGISTRY=ghcr.io/your-github-user
# IMAGE_TAG=3f9a2c1
# Where the daily dumps are kept, outside the releases.
# BACKUP_DIR=/srv/echo/data/dumps
