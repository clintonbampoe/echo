{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "echo_db"
  },
  "Cache": {
    "DefaultTtl": "00:02:00",
    "CacheNulls": false
  },
  "Jwt": {
    "Issuer": "echo-api",
    "Audience": "echo-clients",
    "AccessTokenLifetimeMinutes": 86400,
    "RefreshTokenLifetimeDays": 30
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Api": {
    "BaseUrl": "http://localhost:5025"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "MailClient": {
    "Address": "onboarding@resend.dev"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5025"
      }
    }
  },
  "RunMigrationsOnStartup": false,
  "AllowedHosts": "*"
}
