# The observability server's front door. Rendered at start-up: the image fills in ${OBS_DOMAIN} from the environment.
# Only Grafana is reachable from the browser. Loki, Prometheus and Tempo stay on the private network.

# Grafana Live (the dashboards' push updates) is a WebSocket: pass the upgrade through, and only when asked for.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name ${OBS_DOMAIN};

    # Let's Encrypt proves we own the name by fetching a file from here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${OBS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${OBS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${OBS_DOMAIN}/privkey.pem;
    include /etc/nginx/tls.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        return 302 /grafana/;
    }

    # Grafana is told it lives under /grafana (serve_from_sub_path), so the path goes through unchanged.
    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Grafana sends its own HSTS; tls.conf already did.
        proxy_hide_header Strict-Transport-Security;
    }

    location / {
        return 404;
    }
}
