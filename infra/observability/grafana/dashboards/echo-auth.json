    {
      "type": "timeseries",
      "title": "Password resets",
      "description": "Many requests and few completions is someone probing for accounts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(auth_password_reset_requested_total[$__rate_interval]))",
          "legendFormat": "requested"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(auth_password_reset_completed_total[$__rate_interval]))",
          "legendFormat": "completed"
        }
