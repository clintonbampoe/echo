        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(aspnetcore_authentication_challenges_total[$__rate_interval]))",
          "legendFormat": "challenges"
