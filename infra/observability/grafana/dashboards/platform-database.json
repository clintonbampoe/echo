        "w": 3,
        "x": 3,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Reads answered from memory. Low means it is reading from disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * sum(rate(pg_stat_database_blks_hit{datname=\"echo_db\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{datname=\"echo_db\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"echo_db\"}[$__rate_interval])))) or vector(100)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
