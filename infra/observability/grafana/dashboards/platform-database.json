    {
      "type": "timeseries",
      "title": "Rows per second",
      "description": "Returned far above fetched means queries scan rows they then discard: a missing index.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
