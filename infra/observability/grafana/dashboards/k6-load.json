          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (name, testid) (increase(k6_http_req_duration_seconds{testid=~\"$testid\",phase=\"steady\"}[$__range])))",
          "legendFormat": "p95",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (name, testid) (increase(k6_http_req_duration_seconds{testid=~\"$testid\",phase=\"steady\"}[$__range])))",
          "legendFormat": "p99",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, testid) (increase(k6_http_reqs_total{testid=~\"$testid\",phase=\"steady\"}[$__range]))",
          "legendFormat": "requests",
          "instant": true,
          "range": false,
          "format": "table"
        }
