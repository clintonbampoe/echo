    {
      "type": "table",
      "title": "Routes",
      "description": "Exact p95 and p99 of each route over the time range, steady phase only (the first minute is warm-up). Select one run, or two to compare, and set the time range to cover it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
