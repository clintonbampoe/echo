{
  "uid": "echo-tenants",
  "title": "Echo / Tenants and product",
  "description": "Who is using Echo, and how much. Churches appear as the first 8 characters of their id; the metrics carry no names on purpose.",
  "tags": [
    "echo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Echo dashboards",
      "type": "dashboards",
      "tags": [
        "echo"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
