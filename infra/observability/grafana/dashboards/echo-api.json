    {
      "type": "table",
      "title": "Slowest routes (p95)",
      "description": "Over the time range shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(topk(10, histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[$__range])))), \"route\", \"$1\", \"http_route\", \"(.*)\"), \"route\", \"$1\", \"route\", \"/api/v\\\\{version:apiVersion\\\\}(.*)\"), \"route\", \"(no route)\", \"route\", \"\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(route|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "route": 0,
              "Value": 1
            },
            "renameByName": {
              "route": "Route",
              "Value": "p95",
              "Value #A": "p95"
            }
          }
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
