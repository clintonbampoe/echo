    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "The 8 busiest routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(topk(8, sum by (http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))), \"route\", \"$1\", \"http_route\", \"(.*)\"), \"route\", \"$1\", \"route\", \"/api/v\\\\{version:apiVersion\\\\}(.*)\"), \"route\", \"(no route)\", \"route\", \"\")",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "2xx fine, 4xx the caller, 5xx us.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (label_replace(rate(http_server_request_duration_seconds_count[$__rate_interval]), \"class\", \"${1}xx\", \"http_response_status_code\", \"(.).*\"))",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
