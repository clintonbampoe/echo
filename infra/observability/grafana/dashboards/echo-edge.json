    {
      "type": "table",
      "title": "Slowest paths (p95)",
      "description": "Ids in a path make each its own row, so a busy page can appear several times.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, quantile_over_time(0.95, {container=\"nginx\", stream=\"stdout\"} | rt != \"\" | path != \"\" | unwrap rt [$__range]) by (path))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(path|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "path": 0,
              "Value": 1
            },
            "renameByName": {
              "path": "Path",
              "Value": "p95",
              "Value #A": "p95"
            }
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Callers refused most (429)",
      "description": "An address refused again and again is a script, or an office behind one address.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (ip) (count_over_time({container=\"nginx\", stream=\"stdout\", status=\"429\"} | ip != \"\" [$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Refused",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(ip|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "ip": 0,
              "Value": 1
            },
            "renameByName": {
              "ip": "Address",
              "Value": "Refused",
              "Value #A": "Refused"
            }
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
