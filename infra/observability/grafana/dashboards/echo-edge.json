          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {container=\"nginx\", stream=\"stdout\"} | rt != \"\" | unwrap rt [$__interval]) by ()",
          "legendFormat": "p95"
