{
  "uid": "echo-edge",
  "title": "Echo / Edge (nginx)",
  "description": "What the front door saw: every request, what it answered, and what it refused. From nginx's own log, so it also shows requests that never reached the API.",
  "tags": [
    "echo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
