# Copy to .env (git-ignored). Used by the observability stack.

# Grafana's admin account. Use a long random password; create everyone else as their own user in Grafana.
GF_ADMIN_PASSWORD=CHANGE_ME

# --- Production only (docker-compose.prod.yml) ---------------------------------------------------------
# The name this server is reached on (Grafana is at https://OBS_DOMAIN/grafana/). Its DNS record must point at this
# server before the first certificate is requested.
OBS_DOMAIN=obs.example.net

# Where Let's Encrypt sends expiry warnings, and "1" to use its staging service (certificates browsers do not trust,
# but no rate limits) while trying things out.
CERTBOT_EMAIL=you@example.net
CERTBOT_STAGING=0

# This server's PRIVATE address (for example 10.0.0.2), the one the app server reaches. Loki, Prometheus and
# Tempo accept telemetry on it. Never a public address, and block these ports from the internet.
OBS_BIND_IP=10.0.0.2

# --- Production only: the deploy script sets these per release ---------------------------------------------
# IMAGE_REGISTRY=ghcr.io/your-github-user
# IMAGE_TAG=3f9a2c1

# --- Optional: how long each store keeps data (the values below are the defaults) ----------------------------
# Loki keeps warnings and errors for LOKI_RETENTION and nginx's request lines for LOKI_NGINX_RETENTION.
# LOKI_RETENTION=672h
# LOKI_NGINX_RETENTION=168h
# TEMPO_RETENTION=168h
# PROMETHEUS_RETENTION=30d
