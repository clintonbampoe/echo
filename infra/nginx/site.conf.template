
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name ${APP_DOMAIN} status.${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/tls.conf;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/api-locations.conf;
    include /etc/nginx/grafana-locations.conf;

    location /assets/ {
        include /etc/nginx/spa-headers.conf;
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/spa-headers.conf;
        expires -1;
    }

    location / {
        include /etc/nginx/spa-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name status.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/tls.conf;

    location / {
        resolver 127.0.0.11 valid=10s;
        set $gatus http://status:8080;

        proxy_pass $gatus;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
