# Copy to .env (git-ignored) and fill in. Compose reads it for the Alloy container.

# Read-only Postgres role for the exporter. Create it with infra/postgres/create-monitor-role.sh.
PG_MONITOR_DSN=postgresql://monitor:CHANGE_ME@database:5432/DB_NAME?sslmode=disable

# Names this machine in every metric and log (the "host" label). Use echo-app on the app server.
# ALLOY_HOST=echo-app

# Where to send telemetry. Leave unset when the observability stack is on the same machine and the same Docker network.
# With a separate observability server, set its PRIVATE address (never a public one). Loki, Prometheus and Tempo
# are then reached on it at their usual ports (3100, 9090, 4317):
# OBS_HOST=10.0.0.2
# Only if one of the three lives somewhere else, override it on its own (these win over OBS_HOST):
# LOKI_URL=http://10.0.0.3:3100
# PROMETHEUS_URL=http://10.0.0.3:9090
# TEMPO_OTLP_ENDPOINT=10.0.0.3:4317

# Lowest level of API log sent to Loki: 13 = warnings and above (default), 9 = adds information, 5 = adds debug.
# Information is request chatter: expect thousands of lines a second under a load test.
# API_LOG_MIN_SEVERITY=13

# Share of ordinary traces kept, in percent (default 1). Failed, rejected (400, 403, 409, 429) and slow (over 100 ms) requests are always
# kept in full. 100 keeps everything while debugging.
# TRACES_SAMPLE_PERCENT=1
