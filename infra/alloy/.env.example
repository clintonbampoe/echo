# Copy to .env (git-ignored) and fill in. Compose reads it for the Alloy container.

# Read-only Postgres role for the exporter. Create it with infra/postgres/create-monitor-role.sh.
PG_MONITOR_DSN=postgresql://monitor:CHANGE_ME@database:5432/DB_NAME?sslmode=disable

# Names this machine in every metric and log (the "host" label). Use echo-app on the app server.
# ALLOY_HOST=echo-app

# Where to send telemetry. Leave unset when the observability stack is on the same machine and the same Docker network.
# With a separate observability server, point these at its PRIVATE address (never a public one):
# LOKI_URL=http://10.0.0.2:3100
# PROMETHEUS_URL=http://10.0.0.2:9090
# TEMPO_OTLP_ENDPOINT=10.0.0.2:4317
