discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "docker_logs" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.logs.receiver]
}

loki.process "logs" {
  stage.docker {}

  // Not worth keeping: the observability stack's own logs, the API's stdout (the API sends the same lines over OTLP,
  // with trace ids), the Vite dev server and Portainer.
  stage.drop {
    source              = "container"
    expression          = "^(alloy|grafana|loki|prometheus|tempo|api|frontend|portainer)$"
    drop_counter_reason = "not-kept"
  }

  // ------------------------------------------------------------------------------------------------------------
  // nginx access log. nginx writes JSON (easy to parse); Loki stores a readable line instead:
  //     GET /api/v1/members · 200 · 0.032 s · 172.19.0.1
  // "status", "method" and a "level" (error for 5xx, warn for 4xx) are labels, so Grafana colours the row and
  // "every 429 in the last hour" is a cheap query. The rest (path, request time, upstream time, address, browser,
  // bytes) are fields shown when a line is opened, and usable in queries, but are not part of the line.
  // nginx logs every error and a random 1% of the rest. "sampled" is 1 for that 1%: a request count is the lines
  // with sampled="1" times 100, and a request-time percentile is taken over those lines only.
  // ------------------------------------------------------------------------------------------------------------
  stage.match {
    selector = "{container=\"nginx\", stream=\"stdout\"}"

    stage.json {
      expressions = { status = "status", method = "method", path = "path", rt = "rt", urt = "urt", ip = "ip", ua = "ua", bytes = "bytes", sampled = "sampled", trace_id = "trace_id" }
    }

    stage.labels {
      values = { status = "", method = "" }
    }

    stage.structured_metadata {
      values = { path = "", rt = "", urt = "", ip = "", ua = "", bytes = "", sampled = "", trace_id = "" }
    }

    stage.template {
      source   = "line"
      template = "{{ .method }} {{ .path }} · {{ .status }} · {{ .rt }} s · {{ .ip }}"
    }

    stage.output {
      source = "line"
    }
  }

  stage.match {
    selector = "{container=\"nginx\", stream=\"stdout\", status=~\"5..\"}"

    stage.static_labels {
      values = { level = "error" }
    }
  }

  stage.match {
    selector = "{container=\"nginx\", stream=\"stdout\", status=~\"4..\"}"

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = "{container=\"nginx\", stream=\"stdout\", status!~\"[45]..\"}"

    stage.static_labels {
      values = { level = "info" }
    }
  }

  // nginx's own error log is plain text: "2026/10/30 22:00:00 [error] 29#29: ...". Its level becomes the label.
  stage.match {
    selector = "{container=\"nginx\", stream=\"stderr\"}"

    stage.regex {
      expression = "^\\S+ \\S+ \\[(?P<level>[a-z]+)\\] "
    }

    stage.labels {
      values = { level = "" }
    }
  }

  // ------------------------------------------------------------------------------------------------------------
  // Postgres. A statement can run over many lines, and Docker records each line as its own entry, so first gather
  // every line that does not start with a timestamp into the entry before it. Then take the prefix
  // ("2026-10-30 22:21:05.995 UTC [27568] postgres@echo_db LOG:  ") apart: the message becomes the line, the level
  // becomes a label (error, warn or info), and the process id, user and database become fields.
  // ------------------------------------------------------------------------------------------------------------
  stage.match {
    selector = "{container=\"database\"}"

    stage.multiline {
      firstline     = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
      max_wait_time = "3s"
    }

    stage.regex {
      expression = "(?s)^\\S+ \\S+ \\S+ \\[(?P<pid>\\d+)\\] (?:(?P<user>[^@\\s]*)@(?P<db>\\S+) )?(?P<pglevel>[A-Z]+):\\s+(?P<msg>.*)$"
    }

    stage.template {
      source   = "level"
      template = "{{ if or (eq .pglevel \"ERROR\") (eq .pglevel \"FATAL\") (eq .pglevel \"PANIC\") }}error{{ else if eq .pglevel \"WARNING\" }}warn{{ else }}info{{ end }}"
    }

    stage.labels {
      values = { level = "" }
    }

    stage.structured_metadata {
      values = { pid = "", user = "", db = "", pglevel = "" }
    }

    stage.output {
      source = "msg"
    }
  }

  forward_to = [loki.write.obs.receiver]
}

loki.write "obs" {
  endpoint {
    url = coalesce(sys.env("LOKI_URL"), string.format("http://%s:3100", coalesce(sys.env("OBS_HOST"), "loki"))) + "/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs    = [otelcol.processor.filter.warnings.input]
    traces  = [otelcol.processor.tail_sampling.traces.input]
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
  }
}

// Only warnings and above from the API reach Loki by default. Everything below is request chatter that the traces
// already show, and a load test turns it into thousands of lines a second. To see more, set API_LOG_MIN_SEVERITY in
// .env (OpenTelemetry numbers: 5 debug, 9 information, 13 warning, 17 error) and recreate Alloy.
otelcol.processor.filter "warnings" {
  error_mode = "ignore"

  logs {
    log_record = [string.format("severity_number < %s", sys.env("API_LOG_MIN_SEVERITY"))]
  }

  output {
    logs = [otelcol.processor.transform.tidy_logs.input]
  }
}

// ASP.NET and EF attach a dozen bookkeeping attributes to every log record (connection id, parent span, SDK
// version...). They bury the two that matter (trace_id for the trace link, RequestPath), so leave them out. Logs from
// the Echo.Auth classes (sign-in, renewal, passwords...) get category="auth", so the auth dashboard can show them.
otelcol.processor.transform "tidy_logs" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `delete_key(attributes, "ConnectionId")`,
      `delete_key(attributes, "ParentId")`,
      `delete_key(attributes, "SpanId")`,
      `delete_key(attributes, "TraceId")`,
      `delete_key(attributes, "{OriginalFormat}")`,
      `set(attributes["category"], "auth") where IsMatch(instrumentation_scope.name, "^Echo[.]Auth[.]")`,
    ]
  }

  log_statements {
    context    = "resource"
    statements = [
      `delete_key(attributes, "telemetry.sdk.language")`,
      `delete_key(attributes, "telemetry.sdk.name")`,
      `delete_key(attributes, "telemetry.sdk.version")`,
    ]
  }

  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}

// The API traces every request; this is where the keep-or-drop decision is made, once a trace is complete. A trace is
// kept if ANY policy matches, so every failed, rejected or slow request is kept whole (all its spans, database queries
// included) and only ordinary fast successes are thinned to TRACES_SAMPLE_PERCENT. Spans are held for decision_wait
// before the decision, so this needs every span of a request to reach this one Alloy.
otelcol.processor.tail_sampling "traces" {
  decision_wait = "10s"
  num_traces    = 10000

  // Slow means over 100 ms, about twelve times the API's p95 (8.5 ms), so only the slowest few percent are kept.
  // Exceptions and 5xx: ASP.NET marks these spans as errors.
  policy {
    name = "errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  // The 4xx worth a trace: 400 (a request the API did not accept), 403 (a permission or congregation boundary),
  // 409 (a conflict) and 429 (rate limited). ASP.NET does not mark these as errors, so match on the status code.
  // 401 (every expired token) and 404 (bots, stale links) are left out: they are routine and would fill Tempo.
  policy {
    name = "client-errors"
    type = "ottl_condition"

    ottl_condition {
      error_mode = "ignore"
      span       = [`attributes["http.response.status_code"] == 400 or attributes["http.response.status_code"] == 403 or attributes["http.response.status_code"] == 409 or attributes["http.response.status_code"] == 429`]
    }
  }

  // A sign-in refused because the password-check line was full (503, auth.result = busy). ASP.NET marks every 5xx as an
  // error, so without this each refused person would keep a whole trace, and in a burst there are hundreds a second. They
  // are counted by the auth dashboard (sign-ins turned away) instead. A drop policy wins over every policy that matches.
  policy {
    name = "refused-sign-ins"
    type = "drop"

    drop {
      drop_sub_policy {
        name = "busy"
        type = "string_attribute"

        string_attribute {
          key    = "auth.result"
          values = ["busy"]
        }
      }
    }
  }

  policy {
    name = "slow"
    type = "latency"

    latency {
      threshold_ms = 100
    }
  }

  policy {
    name = "sample"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = encoding.from_json(sys.env("TRACES_SAMPLE_PERCENT"))
    }
  }

  output {
    traces = [otelcol.processor.batch.traces.input, otelcol.processor.filter.slow_requests.input]
  }
}

// A log line for every slow request, built from the API's own spans, so its duration is what the API measured and its
// trace id is the real one. Only server spans (one per request) of 100 ms or more are kept, and 500 ms or more for the
// /auth routes, where a sign-in takes about 175 ms by design (bcrypt) and 100 ms would log every one. Time a sign-in spent
// waiting in line for a password check (the API tags it auth.hash.wait_ms) is left out: the line is meant to hold people
// for up to 10 s in a burst, and that is not slowness. It is counted by the auth dashboard instead; a sign-in is logged only
// when the rest of its time, the work, is 500 ms or more. The traces that reach here are
// the ones tail sampling kept, and every slow one is. When most requests are slow, as in an overload, this logs most of
// them.
otelcol.processor.filter "slow_requests" {
  error_mode = "ignore"

  traces {
    span = [
      `kind != SPAN_KIND_SERVER`,
      `not IsMatch(attributes["http.route"], ".*/auth/.*") and (end_time_unix_nano - start_time_unix_nano) < 100000000`,
      `IsMatch(attributes["http.route"], ".*/auth/.*") and attributes["auth.hash.wait_ms"] == nil and (end_time_unix_nano - start_time_unix_nano) < 500000000`,
      `IsMatch(attributes["http.route"], ".*/auth/.*") and attributes["auth.hash.wait_ms"] != nil and (end_time_unix_nano - start_time_unix_nano - attributes["auth.hash.wait_ms"] * 1000000) < 500000000`,
    ]
  }

  output {
    traces = [otelcol.connector.spanlogs.slow_requests.input]
  }
}

otelcol.connector.spanlogs "slow_requests" {
  spans           = true
  span_attributes = ["http.request.method", "http.route", "http.response.status_code", "url.path", "auth.hash.wait_ms"]

  output {
    logs = [otelcol.processor.transform.slow_request_logs.input]
  }
}

// The connector writes everything inside one line (tid=..., dur=208347000ns). Loki and the dashboards expect the trace id
// as the trace_id field, as on the API's own logs, which is what the "View trace" link reads, and a person wants
// "slow request: POST /api/v1/auth/sessions/login · 200 · 208 ms". The route template and duration stay as fields for
// queries, and requests under /auth get category="auth", the same as the API's own logs from the Echo.Auth classes.
otelcol.processor.transform "slow_request_logs" {
  error_mode = "ignore"

  log_statements {
    context    = "log"
    statements = [
      `set(attributes["trace_id"], ExtractPatterns(body, "tid=(?P<v>[0-9a-f]{32})")["v"])`,
      `set(attributes["duration_ms"], Int(ExtractPatterns(body, "dur=(?P<v>[0-9]+)ns")["v"]) / 1000000)`,
      `set(attributes["http.request.method"], ExtractPatterns(body, "http.request.method=(?P<v>[^ ]+)")["v"])`,
      `set(attributes["http.route"], ExtractPatterns(body, "http.route=(?P<v>[^ ]+)")["v"])`,
      `set(attributes["http.response.status_code"], ExtractPatterns(body, "http.response.status_code=(?P<v>[0-9]+)")["v"])`,
      `set(attributes["url.path"], ExtractPatterns(body, "url.path=(?P<v>[^ ]+)")["v"])`,
      `set(attributes["queue_wait_ms"], Int(ExtractPatterns(body, "auth.hash.wait_ms=(?P<v>[0-9]+)")["v"]))`,
      `set(attributes["slow_request"], true)`,
      `set(attributes["category"], "auth") where IsMatch(attributes["http.route"], ".*/auth/.*")`,
      `set(body, Concat(["slow request:", attributes["http.request.method"], attributes["url.path"], "·", attributes["http.response.status_code"], "·", Concat([attributes["duration_ms"], "ms"], " ")], " "))`,
      `set(severity_number, SEVERITY_NUMBER_INFO)`,
      `set(severity_text, "INFO")`,
    ]
  }

  log_statements {
    context    = "resource"
    statements = [
      `set(attributes["service.name"], "Echo.Api")`,
    ]
  }

  output {
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.processor.batch "traces" {
  send_batch_max_size = 2000
  timeout             = "5s"

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = coalesce(sys.env("TEMPO_OTLP_ENDPOINT"), string.format("%s:4317", coalesce(sys.env("OBS_HOST"), "tempo")))
    tls {
      insecure = true
    }
  }
}

// Native OTLP ingestion: Loki 3.5 parses the protobuf itself -> log body becomes
// the message text, trace_id/span_id/severity become structured metadata.
// (The old otelcol.exporter.loki flattened every record into raw JSON.)
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = coalesce(sys.env("LOKI_URL"), string.format("http://%s:3100", coalesce(sys.env("OBS_HOST"), "loki"))) + "/otlp"
  }
}

// The API's metrics go to Prometheus's own OTLP endpoint (not through remote write), because OTLP carries each counter's
// start time and Prometheus uses it to count a counter's first event. The machine, container and Postgres metrics
// below still use remote write: they are gauges and scraped counters that never start mid-flight.
otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = coalesce(sys.env("PROMETHEUS_URL"), string.format("http://%s:9090", coalesce(sys.env("OBS_HOST"), "prometheus"))) + "/api/v1/otlp"
  }
}

prometheus.remote_write "obs" {
  endpoint {
    url = coalesce(sys.env("PROMETHEUS_URL"), string.format("http://%s:9090", coalesce(sys.env("OBS_HOST"), "prometheus"))) + "/api/v1/write"
  }
}

// ---------------------------------------------------------------------------
// Container and host metrics. Alloy's built-in exporters, so no extra containers.
// They write straight to Prometheus (not through the app pipeline above, which
// copies the OTLP "job" into service_name).
// ---------------------------------------------------------------------------

// One series per Docker container: CPU, memory, network, disk IO, OOM kills.
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
  // Docker labels (compose dependency lists, paths) would become long metric labels. Not wanted.
  store_container_labels = false
  enabled_metrics  = ["cpu", "memory", "network", "diskIO", "oom_event"]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  forward_to      = [prometheus.relabel.containers.receiver]
  scrape_interval = "15s"
  job_name        = "containers"
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.obs.receiver]

  // Keep only what the dashboards and alerts use. cAdvisor emits hundreds of series per container.
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|cpu_cfs_throttled_periods_total|cpu_cfs_periods_total|memory_working_set_bytes|memory_usage_bytes|memory_cache|memory_failcnt|spec_memory_limit_bytes|spec_cpu_quota|network_(receive|transmit)_(bytes|errors|packets_dropped)_total|fs_(reads|writes)_bytes_total|oom_events_total|start_time_seconds|last_seen)"
    action        = "keep"
  }

  // The name the logs use ("api", "database"), so one dashboard variable drives metrics and logs.
  rule {
    source_labels = ["name"]
    target_label  = "container"
  }
  // Only containers with a name (the Docker containers); drops the cgroup roots.
  rule {
    source_labels = ["container"]
    regex         = ""
    action        = "drop"
  }
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
  rule {
    action = "labeldrop"
    regex  = "id|name|container_label_.*"
  }
}

// The machine itself: CPU, load, memory, swap, disk space and IO, network.
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  // "pressure" (how long tasks waited for a core, from Linux's pressure stall information) and "schedstat" (the same per
  // core) show a CPU that is too busy to answer quickly even when it is not at 100%.
  set_collectors = ["cpu", "loadavg", "meminfo", "vmstat", "diskstats", "filesystem", "netdev", "stat", "time", "uname", "pressure", "schedstat"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.host.receiver]
  scrape_interval = "15s"
  job_name        = "host"
}

prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.obs.receiver]

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}

// ---------------------------------------------------------------------------
// Postgres: connections, cache hit ratio, locks, transactions, size, checkpoints, and per-query statistics
// (pg_stat_statements, normalised: $1 in place of every value, so it holds no data of the church's).
// Signs in as the read-only "monitor" role (infra/postgres/create-monitor-role.sh).
// ---------------------------------------------------------------------------
prometheus.exporter.postgres "db" {
  data_source_names  = [sys.env("PG_MONITOR_DSN")]
  // The SQL behind the busiest query ids (queries.yaml), so the statements tables on the Database dashboard can show it.
  custom_queries_config_path = "/etc/alloy/queries.yaml"
  // Named in full: only the collectors listed here run.
  enabled_collectors = [
    "database",
    "locks",
    "postmaster",
    "stat_bgwriter",
    "stat_database",
    "stat_user_tables",
    "statio_user_tables",
    "stat_statements",
    "long_running_transactions",
    "wal",
  ]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.db.targets
  forward_to      = [prometheus.relabel.postgres.receiver]
  scrape_interval = "15s"
  job_name        = "postgres"
}

prometheus.relabel "postgres" {
  forward_to = [prometheus.remote_write.obs.receiver]

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
}
